# =============================================================================
# TeleRAG — Mavenir 3GPP Standards Intelligence Assistant
# Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your API keys.
# NEVER commit .env to version control.
# =============================================================================

# --- LLM: Primary (Google Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- LLM: Fallback (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Embedding ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Chunking ---
CHUNK_SIZE=1024
CHUNK_OVERLAP=128

# --- Retrieval ---
VECTOR_TOP_K=20
BM25_TOP_K=20
RRF_TOP_K=30
RERANK_TOP_K=8

# --- Grounding & Verification ---
RETRIEVAL_SCORE_THRESHOLD=0.25
EVIDENCE_THRESHOLD=0.4
VERIFICATION_THRESHOLD=0.5
MAX_CONTEXT_CHUNKS=6

# --- Generation ---
TEMPERATURE=0.1
MAX_OUTPUT_TOKENS=1024

# --- Storage ---
VECTOR_DB_PATH=storage/vector
BM25_INDEX_PATH=storage/bm25
METADATA_DB_PATH=storage/metadata/telerag.db

# --- Corpus ---
CORPUS_RELEASE=18
AUTO_DOWNLOAD_CORPUS=true
CORPUS_TIER=FULL

# --- Debug ---
DEBUG_MODE=false

# --- Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
